# Variáveis do Auth da instância, lidas por supabase/config.toml (item 1.3; docs/PUBLICACAO-CRM.md,
# "Acesso e e-mails"). Copie este arquivo para supabase/.env (fora do Git), troque cada valor de exemplo
# e rode npm run config:check. Nenhuma destas variáveis vai para o frontend.
# Um valor com "$" (comum em senhas) vai entre aspas simples, como SUPABASE_AUTH_SMTP_PASS='abc$123':
# sem aspas ou entre aspas duplas, o Supabase CLI troca "$NOME" pelo valor de outra variável.

# Endereço do CRM publicado: https://, em minúsculas, sem caminho e sem barra no fim.
SUPABASE_AUTH_SITE_URL=https://crm.suaempresa.com.br
# Exatamente o endereço acima seguido de /**, para os links dos e-mails voltarem ao convite.
SUPABASE_AUTH_REDIRECT_URL=https://crm.suaempresa.com.br/**

# SMTP próprio (domínio da empresa, um provedor transacional ou o Gmail com senha de app).
SUPABASE_AUTH_SMTP_HOST=smtp.seuprovedor.com
SUPABASE_AUTH_SMTP_PORT=587
SUPABASE_AUTH_SMTP_USER=acesso@suaempresa.com.br
SUPABASE_AUTH_SMTP_PASS=cole-aqui-a-senha-do-smtp
# Remetente dos e-mails e o nome que aparece na caixa de entrada.
SUPABASE_AUTH_SMTP_ADMIN_EMAIL=acesso@suaempresa.com.br
SUPABASE_AUTH_SMTP_SENDER_NAME=CRM Sua Empresa

# Supabase local (Docker; fora do caminho da implantação): crie supabase/.env.local com
#   SUPABASE_AUTH_SITE_URL=http://localhost:8080
#   SUPABASE_AUTH_REDIRECT_URL=http://localhost:8080/**
#   SUPABASE_AUTH_SMTP_HOST=127.0.0.1 e SUPABASE_AUTH_SMTP_PORT=54325 (o Mailpit local),
#   e quaisquer usuário, senha, remetente e nome; confira com npm run config:check -- --local.
# O Supabase CLI lê o supabase/.env.local antes do supabase/.env, também no push: apague ou renomeie
# o supabase/.env.local antes de um npm run config:push (o check recusa enquanto ele existir).
