# Configure only the independent CRM project. Never reuse the source project's keys.
VITE_CRM_ENVIRONMENT=dedicated
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# A marca (nome, logos, ícone, e-mail de suporte e nomes dos arquivos exportados) não usa variáveis: fica em
# public/brand/brand.json (docs/MARCA.md). O e-mail de suporte é o "supportEmail" desse arquivo; VITE_SUPPORT_EMAIL
# ficou obsoleta e só vale, com aviso no build, quando ele está vazio.
# Opcional: true ou false sobrepõe, só no app desta implantação, o "showBaseCredit" do brand.json (o crédito
# "Feito com Empreende.IA", que nunca aparece com a marca do programa). Vazia ou ausente, vale o arquivo; os e-mails
# de acesso seguem sempre o arquivo.
# VITE_SHOW_BASE_CREDIT=
